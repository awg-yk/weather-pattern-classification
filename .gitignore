.venv/
__pycache__/
*.pyc
data/raw/
data/processed/
*.pt
*.pth
!weights/model.pt
# 注釈付き画像(検出した枠を描き込んだもの)で学習した重み。
# 素の天気図用とは入力が違うので、別名で同梱する。
# 使うときは scripts/predict.py --annotate と必ず組にすること
!weights/model_annot.pt
.cdsapirc
.env
.DS_Store
node_modules/

# 交差検証の出力。まとめ(summary.json)だけ残して、foldごとの中間ファイルは残さない。
# どの条件で出た数字かはsummary.json内のconfigに入っているので、まとめさえあれば
# 後から比較できる(scripts/compare_runs.py がこれを読む)。
runs/*
!runs/*/
runs/*/*
!runs/*/summary.json

# ERA5から再計算できる中間データ(scripts/era5_features.py)
data/era5_features_all.csv

# scripts/apply_label_rule.py が書き換え前に残す控え。
# 中身は直前のラベルCSVそのものなので、追跡すると版が二重になる
*.bak
